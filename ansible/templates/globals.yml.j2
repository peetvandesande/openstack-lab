# {{ ansible_managed }}
# Kolla-Ansible configuration for the OpenStack lab. Edit
# ansible/templates/globals.yml.j2, not this file.

kolla_base_distro: "ubuntu"
openstack_release: "{{ openstack_release }}"

# Networks: NICs are named after the network they are on (see network.conf)
network_interface: "mgmt"
api_interface: "mgmt"
kolla_external_vip_interface: "api"
storage_interface: "stor"
tunnel_interface: "tun"
dns_interface: "api"
neutron_external_interface: "ext,lbmp"
neutron_bridge_name: "br-ex,br-lbm"

# HAProxy and keepalived in front of every API, on two VIPs
kolla_internal_vip_address: "{{ internal_vip }}"
kolla_external_vip_address: "{{ external_vip }}"
kolla_external_fqdn: "{{ public_fqdn }}"
keepalived_virtual_router_id: "61"

# TLS on the public endpoints, signed by a lab CA (kolla-ansible certificates)
kolla_enable_tls_external: "yes"
kolla_copy_ca_into_containers: "yes"
openstack_cacert: "/etc/ssl/certs/ca-certificates.crt"
kolla_admin_openrc_cacert: "/etc/kolla/certificates/ca/root.crt"

# Networking: OVN with distributed floating IPs, so instance traffic leaves
# from the node it runs on
neutron_plugin_agent: "ovn"
neutron_ovn_distributed_fip: "yes"
enable_neutron_qos: "yes"
enable_neutron_trunk: "yes"
enable_neutron_port_forwarding: "yes"

# Compute: nested KVM
nova_compute_virt_type: "kvm"

# Storage: everything on the Ceph cluster deployed by ansible/ceph.yml
enable_cinder: "yes"
enable_cinder_backup: "yes"
glance_backend_ceph: "yes"
cinder_backend_ceph: "yes"
cinder_backup_driver: "ceph"
# Active-active cinder-volume on every node, coordinated through Valkey
cinder_cluster_name: "openstack-lab"
nova_backend_ceph: "yes"

# Coordination for active-active Cinder on Ceph, and Octavia's jobboard
enable_valkey: "yes"

# Orchestration
enable_heat: "yes"
enable_horizon: "yes"

# Load balancers. Amphora VMs sit on a flat provider network (physnet2,
# br-lbm) and reach the health managers on the nodes' lbm addresses; with
# OVN, Kolla does not support a tenant network for this. The OVN provider
# needs no VMs at all
enable_octavia: "{{ enable_octavia | ternary('yes', 'no') }}"
{% if enable_octavia %}
octavia_auto_configure: "yes"
octavia_network_type: "provider"
octavia_network_interface: "lbm"
octavia_amp_network:
  name: lb-mgmt-net
  provider_network_type: flat
  provider_physical_network: physnet2
  external: false
  shared: false
  subnet:
    name: lb-mgmt-subnet
    cidr: "{{ lab_net.lbmgmt_subnet }}"
    allocation_pool_start: "{{ lab_net.lbmgmt_pool_start }}"
    allocation_pool_end: "{{ lab_net.lbmgmt_pool_end }}"
    enable_dhcp: yes
{% endif %}

# DNS as a service, served by BIND on the public network
enable_designate: "{{ enable_designate | ternary('yes', 'no') }}"
{% if enable_designate %}
designate_backend: "bind9"
designate_ns_record:
  - "ns1.{{ lab_net.domain }}"
# Instance names, kept apart from the lab's own records in DOMAIN
neutron_dns_domain: "cloud.{{ lab_net.domain }}."
{% endif %}

# Secrets (Octavia TLS listeners, encrypted volumes)
enable_barbican: "{{ enable_barbican | ternary('yes', 'no') }}"

# Object storage (Swift and S3 API) on Ceph RGW, behind HAProxy
enable_ceph_rgw: "{{ enable_ceph_rgw | ternary('yes', 'no') }}"
{% if enable_ceph_rgw %}
ceph_rgw_swift_compatibility: false
ceph_rgw_swift_account_in_url: true
ceph_rgw_hosts:
{% for h in groups['openstack'] %}
  - host: {{ h }}
    ip: {{ hostvars[h].nics.stor.address.split('/')[0] }}
    port: 7480
{% endfor %}
{% endif %}

# Metering and rating
enable_ceilometer: "{{ enable_metering | ternary('yes', 'no') }}"
enable_gnocchi: "{{ enable_metering | ternary('yes', 'no') }}"
enable_cloudkitty: "{{ enable_metering | ternary('yes', 'no') }}"
{% if enable_metering %}
gnocchi_backend_storage: "ceph"
cloudkitty_storage_backend: "opensearch"
{% endif %}

# Monitoring, including the Ceph manager's exporter
enable_prometheus: "{{ enable_monitoring | ternary('yes', 'no') }}"
enable_grafana: "{{ enable_monitoring | ternary('yes', 'no') }}"
{% if enable_monitoring %}
enable_prometheus_alertmanager: "yes"
enable_prometheus_ceph_mgr_exporter: "yes"
prometheus_ceph_mgr_exporter_endpoints:
{% for h in groups['openstack'] %}
  - "{{ hostvars[h].ansible_host }}:9283"
{% endfor %}
{% endif %}

# Central logging: Fluentd to OpenSearch, with OpenSearch Dashboards
enable_central_logging: "{{ (enable_central_logging or enable_metering) | ternary('yes', 'no') }}"
